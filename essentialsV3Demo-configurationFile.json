    "sourceLists": {
        "default": {
            "laptop": {
                "sourceKey": "source-laptop",
                "name": "Laptop",
                "icon": "Laptop",
                "order": 1,
                "includeInSourceList": true,
                "isAudioSource": true,
                "type": "route",
                "routeList": [
                    { "sourceKey": "source-laptop", "destinationKey": "display1", "type": "audioVideo" },
                    { "sourceKey": "source-laptop", "destinationKey": "display2", "type": "audioVideo" }
                ]
            },
            "wireless": {
                "sourceKey": "source-wireless",
                "name": "Wireless Presentation",
                "icon": "Laptop",
                "order": 2,
                "includeInSourceList": true,
                "isAudioSource": true,
                "type": "route",
                "routeList": [
                    { "sourceKey": "source-wireless", "destinationKey": "display1", "type": "audioVideo" },
                    { "sourceKey": "source-wireless", "destinationKey": "display2", "type": "audioVideo" }
                ]
            },
            "media": {
                "sourceKey": "source-media",
                "name": "Media Player",
                "icon": "Media",
                "order": 3,
                "includeInSourceList": true,
                "isAudioSource": true,
                "type": "route",
                "routeList": [
                    { "sourceKey": "source-media", "destinationKey": "display1", "type": "audioVideo" },
                    { "sourceKey": "source-media", "destinationKey": "display2", "type": "audioVideo" }
                ]
            },
            "cable": {
                "sourceKey": "source-cable",
                "name": "Cable TV",
                "icon": "Cable",
                "order": 4,
                "includeInSourceList": true,
                "isAudioSource": true,
                "type": "route",
                "routeList": [
                    { "sourceKey": "source-cable", "destinationKey": "display1", "type": "audioVideo" },
                    { "sourceKey": "source-cable", "destinationKey": "display2", "type": "audioVideo" }
                ]
            },
            "roomOff": {
                "sourceKey": "$off",
                "name": "Off",
                "order": 99,
                "includeInSourceList": false,
                "type": "off",
                "routeList": [
                    { "sourceKey": "$off", "destinationKey": "display1", "type": "audioVideo" },
                    { "sourceKey": "$off", "destinationKey": "display2", "type": "audioVideo" }
                ]
            }
        }
    },
    "destinationLists": {
        "default": {
            "display1": {
                "sinkKey": "display-1",
                "name": "Display 1",
                "order": 1,
                "sinkType": "audioVideo",
                "includeInDestinationList": true,
                "isProgramAudioDestination": true
            },
            "display2": {
                "sinkKey": "display-2",
                "name": "Display 2",
                "order": 2,
                "sinkType": "audioVideo",
                "includeInDestinationList": true,
                "isProgramAudioDestination": false
            }
        }
    },
    "audioControlPointLists": {
        "default": {
            "levelControls": {
                "program": {
                    "parentDeviceKey": "display-1",
                    "name": "Program",
                    "includeInUserList": true,
                    "order": 1,
                    "type": "levelAndMute"
                },
                "wirelessMic": {
                    "parentDeviceKey": "audio-wireless-mic",
                    "name": "Wireless Mic",
                    "includeInUserList": true,
                    "isMic": true,
                    "order": 2,
                    "type": "levelAndMute"
                },
                "lecternMic": {
                    "parentDeviceKey": "audio-lectern-mic",
                    "name": "Lectern Mic",
                    "includeInUserList": true,
                    "isMic": true,
                    "order": 3,
                    "type": "levelAndMute"
                }
            }
        }
    },
    "rooms": [
        {
            "key": "room1",
            "uid": 100,
            "name": "Demo Room",
            "type": "essentialsDemoRoom",
            "properties": {
                "description": "A simple two-display room with a few sources, lighting scene control, audio level control, and a tech menu for system status.",
                "sourceListKey": "default",
                "destinationListKey": "default",
                "audioControlPointListKey": "default",
                "defaultAudioKey": "audio-room",
                "defaultSourceItem": "laptop",
                "defaultDisplayKey": "display1",
                "enableAudioFollowsVideo": true,
                "shutdownPromptSeconds": 30,
                "help": {
                    "message": "Dial x12345 to reach the Help Desk"
                },
                "environment": {
                    "enabled": true,
                    "deviceKeys": ["lighting-1"]
                },
                "tech": {
                    "password": "1234",
                    "systemStatusDeviceKeys": [
                        "infra-dm-switcher",
                        "infra-wireless-gateway",
                        "infra-network-switch",
                        "infra-control-processor",
                        "infra-dsp",
                        "infra-camera",
                        "infra-room-pc",
                        "infra-poe-injector",
                        "infra-access-point",
                        "infra-video-scaler",
                        "infra-touchpanel-processor",
                        "infra-matrix-router",
                        "infra-ups",
                        "infra-power-sequencer",
                        "infra-ir-repeater"
                    ],
                    "rackSensorDeviceKey": "infra-rack-sensor"
                }
            }
        }
    ]
