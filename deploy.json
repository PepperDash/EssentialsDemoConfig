{
  "devices": [
    {
      "id": "ztso2ygp",
      "label": "Crestron Processor",
      "type": "processor",
      "credential": {
        "source": "manual"
      },
      "mappings": [
        {
          "pattern": "*.cpz",
          "localRoot": "restore",
          "remoteDir": "/program02",
          "children": [
            {
              "pattern": "*configurationFile.json",
              "localRoot": "EssentialsDemoConfig",
              "remoteDir": "/user/program2"
            },
            {
              "pattern": "*.cplz",
              "localRoot": "restore",
              "remoteDir": "/user/program2/plugins"
            },
            {
              "pattern": "*react*.zip",
              "localRoot": "restore",
              "remoteDir": "/user/program2/mcUserApp"
            }
          ],
          "programSlot": "02"
        }
      ]
    }
  ],
  "projectRoot": ".."
}