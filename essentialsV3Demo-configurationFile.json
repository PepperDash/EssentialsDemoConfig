{
  "info": {
    "name": "Essentials Demo",
    "comment": "Public demo/example program for Essentials v3. Every device is mocked - nothing here talks to real AV hardware, so it runs standalone on any 4-series processor.",
    "type": "essentialsDemo",
    "version": "1.0.0"
  },
  "devices": [
    {
      "key": "appServer",
      "name": "App Server",
      "type": "appServer",
      "properties": {
        "serverUrl": "",
        "directServer": {
          "enableDirectServer": true,
          "port": 50002,
          "automaticallyForwardPortToCSLAN": true
        },
        "enableApiServer": false,
        "enableMessengerSubscriptions": true
      }
    },
    {
      "key": "display-1",
      "name": "Left Display",
      "type": "mockdisplay",
      "properties": {}
    },
    {
      "key": "display-2",
      "name": "Right Display",
      "type": "mockdisplay",
      "properties": {}
    },
    {
      "key": "source-laptop",
      "name": "Laptop",
      "type": "mockHdmiSource",
      "properties": {
        "startsWithSync": true
      }
    },
    {
      "key": "source-wireless",
      "name": "Wireless Presentation",
      "type": "genericsource",
      "properties": {}
    },
    {
      "key": "source-media",
      "name": "Media Player",
      "type": "genericsource",
      "properties": {}
    },
    {
      "key": "source-cable",
      "name": "Cable TV",
      "type": "genericsource",
      "properties": {}
    },
    {
      "key": "audio-room",
      "name": "Room Volume",
      "type": "mockaudiodevice",
      "properties": {}
    },
    {
      "key": "program-audio",
      "name": "Program Audio",
      "type": "genericaudiooutwithvolume",
      "properties": {
        "volumeDeviceKey": "audio-room"
      }
    },
    {
      "key": "lighting-1",
      "name": "Room Lighting",
      "type": "mockLightingDevice",
      "properties": {
        "defaultSceneId": "default",
        "scenes": [
          { "id": "allOn", "name": "All On" },
          { "id": "high", "name": "High" },
          { "id": "conference", "name": "Conference" },
          { "id": "default", "name": "Default" },
          { "id": "low", "name": "Low" },
          { "id": "allOff", "name": "All Off" }
        ]
      }
    },
    {
      "key": "audio-wireless-mic",
      "name": "Wireless Mic",
      "type": "mockaudiodevice",
      "properties": {}
    },
    {
      "key": "audio-lectern-mic",
      "name": "Lectern Mic",
      "type": "mockaudiodevice",
      "properties": {}
    },
    {
      "key": "infra-dm-switcher",
      "name": "DM Presentation Switcher",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-wireless-gateway",
      "name": "Wireless Presentation Gateway",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "InError" }
    },
    {
      "key": "infra-network-switch",
      "name": "Network Switch",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-control-processor",
      "name": "Control Processor",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-dsp",
      "name": "DSP Audio Processor",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-camera",
      "name": "PTZ Camera",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-room-pc",
      "name": "Room PC",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-poe-injector",
      "name": "PoE Injector",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-access-point",
      "name": "Wireless Access Point",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-video-scaler",
      "name": "Video Scaler",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "InWarning" }
    },
    {
      "key": "infra-touchpanel-processor",
      "name": "Touch Panel Processor",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "StatusUnknown" }
    },
    {
      "key": "infra-matrix-router",
      "name": "Matrix Router",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-ups",
      "name": "UPS",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-power-sequencer",
      "name": "Power Sequencer",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-ir-repeater",
      "name": "IR Repeater",
      "type": "mockInfrastructureDevice",
      "properties": { "startingStatus": "IsOk" }
    },
    {
      "key": "infra-rack-sensor",
      "name": "Rack Sensor",
      "type": "mockRackSensor",
      "properties": {
        "startingTemperatureF": 78.0,
        "startingHumidityPercent": 10
      }
    },
    {
      "key": "matrix-router",
      "name": "Matrix Router",
      "type": "mockmidpoint",
      "properties": {
        "inputPorts": [
          { "name": "source-laptop", "label": "Laptop", "signalType": "AudioVideo", "txDeviceKey": "source-laptop" },
          { "name": "source-wireless", "label": "Wireless Presentation", "signalType": "AudioVideo" },
          { "name": "source-media", "label": "Media Player", "signalType": "AudioVideo" },
          { "name": "source-cable", "label": "Cable TV", "signalType": "AudioVideo" }
        ],
        "outputPorts": [
          { "name": "display-1", "label": "Left Display", "signalType": "AudioVideo" },
          { "name": "display-2", "label": "Right Display", "signalType": "AudioVideo" },
          { "name": "programAudio", "label": "Program Audio", "signalType": "Audio" }
        ]
      }
    },
        {
      "name": "Test Panel",
      "key": "browser",
      "type": "mcxpanel",
      "properties": {
        "control": {
          "ipid": "05",
          "method": "ipid"
        },
        "defaultRoomKey": "room1",
        "useDirectServer": true,
        "theme": "dark",
        "buttonToolbarTimeoutInS": 30
      }
    },
    {
      "name": "Test TSW",
      "key": "tsw1070",
      "type": "mctsw1070",
      "properties": {
        "control": {
          "ipid": "04",
          "method": "ipid"
        },
        "defaultRoomKey": "room1",
        "useDirectServer": true,
        "theme": "dark",
        "buttonToolbarTimeoutInS": 30,
        "developmentServerAddress": "http://192.168.1.181:5174"
      }
    }
  ],
  "sourceLists": {
    "default": {
      "laptop": {
        "sourceKey": "source-laptop",
        "name": "Laptop",
        "icon": "Laptop",
        "order": 1,
        "includeInSourceList": true,
        "isAudioSource": true,
        "type": "route",
        "routeList": [
          {
            "sourceKey": "source-laptop",
            "destinationKey": "display1",
            "type": "audioVideo"
          },
          {
            "sourceKey": "source-laptop",
            "destinationKey": "display2",
            "type": "audioVideo"
          },
          {
            "sourceKey": "source-laptop",
            "destinationKey": "programAudio",
            "type": "audio"
          }
        ]
      },
      "wireless": {
        "sourceKey": "source-wireless",
        "name": "Wireless Presentation",
        "icon": "Laptop",
        "order": 2,
        "includeInSourceList": true,
        "isAudioSource": true,
        "type": "route",
        "routeList": [
          {
            "sourceKey": "source-wireless",
            "destinationKey": "display1",
            "type": "audioVideo"
          },
          {
            "sourceKey": "source-wireless",
            "destinationKey": "display2",
            "type": "audioVideo"
          },
          {
            "sourceKey": "source-wireless",
            "destinationKey": "programAudio",
            "type": "audio"
          }
        ]
      },
      "media": {
        "sourceKey": "source-media",
        "name": "Media Player",
        "icon": "Media",
        "order": 3,
        "includeInSourceList": true,
        "isAudioSource": true,
        "type": "route",
        "routeList": [
          {
            "sourceKey": "source-media",
            "destinationKey": "display1",
            "type": "audioVideo"
          },
          {
            "sourceKey": "source-media",
            "destinationKey": "display2",
            "type": "audioVideo"
          },
          {
            "sourceKey": "source-media",
            "destinationKey": "programAudio",
            "type": "audio"
          }
        ]
      },
      "cable": {
        "sourceKey": "source-cable",
        "name": "Cable TV",
        "icon": "Cable",
        "order": 4,
        "includeInSourceList": true,
        "isAudioSource": true,
        "type": "route",
        "routeList": [
          {
            "sourceKey": "source-cable",
            "destinationKey": "display1",
            "type": "audioVideo"
          },
          {
            "sourceKey": "source-cable",
            "destinationKey": "display2",
            "type": "audioVideo"
          },
          {
            "sourceKey": "source-cable",
            "destinationKey": "programAudio",
            "type": "audio"
          }
        ]
      },
      "roomOff": {
        "sourceKey": "$off",
        "name": "Off",
        "order": 99,
        "includeInSourceList": false,
        "type": "off",
        "routeList": [
          {
            "sourceKey": "$off",
            "destinationKey": "display1",
            "type": "audioVideo"
          },
          {
            "sourceKey": "$off",
            "destinationKey": "display2",
            "type": "audioVideo"
          },
          {
            "sourceKey": "$off",
            "destinationKey": "programAudio",
            "type": "audio"
          }
        ]
      }
    }
  },
  "destinationLists": {
    "default": {
      "display1": {
        "sinkKey": "display-1",
        "name": "Left Display",
        "order": 1,
        "sinkType": "audioVideo",
        "includeInDestinationList": true,
        "isProgramAudioDestination": false
      },
      "display2": {
        "sinkKey": "display-2",
        "name": "Right Display",
        "order": 2,
        "sinkType": "audioVideo",
        "includeInDestinationList": true,
        "isProgramAudioDestination": false
      },
      "programAudio": {
        "sinkKey": "program-audio",
        "name": "Program Audio",
        "order": 3,
        "sinkType": "audio",
        "includeInDestinationList": false,
        "isProgramAudioDestination": true
      }
    }
  },
  "audioControlPointLists": {
    "default": {
      "levelControls": {
        "program": {
          "parentDeviceKey": "display-1",
          "name": "Program",
          "includeInUserList": true,
          "order": 1,
          "type": "levelAndMute"
        },
        "wirelessMic": {
          "parentDeviceKey": "audio-wireless-mic",
          "name": "Wireless Mic",
          "includeInUserList": true,
          "isMic": true,
          "order": 2,
          "type": "levelAndMute"
        },
        "lecternMic": {
          "parentDeviceKey": "audio-lectern-mic",
          "name": "Lectern Mic",
          "includeInUserList": true,
          "isMic": true,
          "order": 3,
          "type": "levelAndMute"
        }
      }
    }
  },
  "tieLines": [
    { "SourceKey": "source-laptop", "SourcePort": "anyOut", "DestinationKey": "matrix-router", "DestinationPort": "source-laptop" },
    { "SourceKey": "source-wireless", "SourcePort": "anyOut", "DestinationKey": "matrix-router", "DestinationPort": "source-wireless" },
    { "SourceKey": "source-media", "SourcePort": "anyOut", "DestinationKey": "matrix-router", "DestinationPort": "source-media" },
    { "SourceKey": "source-cable", "SourcePort": "anyOut", "DestinationKey": "matrix-router", "DestinationPort": "source-cable" },
    { "SourceKey": "matrix-router", "SourcePort": "display-1", "DestinationKey": "display-1", "DestinationPort": "hdmiIn1", "type": "video" },
    { "SourceKey": "matrix-router", "SourcePort": "display-2", "DestinationKey": "display-2", "DestinationPort": "hdmiIn1", "type": "video" },
    { "SourceKey": "matrix-router", "SourcePort": "programAudio", "DestinationKey": "program-audio", "DestinationPort": "anyAudioIn" }
  ],
  "rooms": [
    {
      "key": "room1",
      "name": "Demo Room",
      "type": "essentialsDemoRoom",
      "properties": {
        "description": "A simple two-display room with a few sources, lighting scene control, audio level control, and a tech menu for system status.",
        "sourceListKey": "default",
        "destinationListKey": "default",
        "audioControlPointListKey": "default",
        "defaultAudioKey": "audio-room",
        "defaultSourceItem": "laptop",
        "defaultDisplayKey": "display1",
        "enableAudioFollowsVideo": true,
        "shutdownPromptSeconds": 30,
        "help": {
          "message": "Dial x12345 to reach the Help Desk"
        },
        "environment": {
          "enabled": true,
          "deviceKeys": ["lighting-1"]
        },
        "tech": {
          "password": "1234",
          "systemStatusDeviceKeys": [
            "infra-dm-switcher",
            "infra-wireless-gateway",
            "infra-network-switch",
            "infra-control-processor",
            "infra-dsp",
            "infra-camera",
            "infra-room-pc",
            "infra-poe-injector",
            "infra-access-point",
            "infra-video-scaler",
            "infra-touchpanel-processor",
            "infra-matrix-router",
            "infra-ups",
            "infra-power-sequencer",
            "infra-ir-repeater"
          ],
          "rackSensorDeviceKey": "infra-rack-sensor",
          "displays": [{ "deviceKey": "display-1" }, { "deviceKey": "display-2" }],
          "routingDeviceKey": "matrix-router"
        }
      }
    }
  ]
}
